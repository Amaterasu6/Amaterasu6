*{
  font-family: Arial, Helvetica, sans-serif;
}

ul{
  justify-content: right;
  margin-right: 30px;
  padding: 1px;
  display: flex;
  gap: 35px;
  font-size: 18px;
  list-style-type: none;
  color: black;
}

ul a{
  text-decoration: none;
  color: black;
}

ul img{
margin-right: 950px;
width: 30px;

}

.container{
  position: relative;
}
.container h1{
position: absolute;
top: 0;
margin: 100px;
font-size: 50px;
color: white;
}
.container img{
width: 1505px;
height: 600px;
}


.img{
  display: flex;
  gap: 30px;
  margin: 200px 0 0 100px;
}

.img-info{
text-align: center;
font-size: 18px;
font-weight: bold;
}

.frame8{
  display: flex;
  max-width:1280px;
  margin: 250px auto 0;
  padding: 0 100px;
  display: flex;
  gap: 80px;
  text-align: left;
  
}

.frame8 img{
  width: 626px;
  height: 626px;
}

.frame8-text{
margin: 200px 50px 100px 10px;

}

.frame8-text button{
  margin-top: 50px;
  width: 135px;
  height: 44px;
  background-color: rgb(255, 255, 255);
  border-radius: 5px;
  font-size: 15px;
}

.frame8-text h1{
  margin-bottom: 30px;
}

.frame8-text p{
  font-size: 17px;

}

