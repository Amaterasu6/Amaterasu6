  margin:150px 100px 0 100px;
}

.frame9-text{
  margin: 200px 50px 100px 0;
  text-align: left;

}

.frame9 h1{
margin-bottom: 25px;
}

.frame9 p{
  font-weight: 17px;
}

.frame9 button{
  margin-top: 50px;
  width: 135px;
  height: 44px;
  background-color: white;
  border-radius: 5px;
  font-size: 15px;
}


