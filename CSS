.frame11{
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 200px;
}

.frame11 img{
  max-width: 100%;
  height: 600px;
}

.input-field {
  position: absolute;
}

.frame11 p{
  text-align: center;
  color: white;
  font-size: 30px;
  margin-bottom: 70px;

}

.frame11 input{
  background-color: transparent;
  width: 520px;
  height: 52px;
  border: solid 2px;
  border-color: white;
}

.frame11 button{
  width: 119px;
  height: 52px;
  background-color: white;
  margin-left: 20px;
  border-color: white;
  font-size: 18px;
}

footer{
